# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do .env.local (ele já está no .gitignore).

# Banco de dados (Neon) — connection string "pooled"
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full"

